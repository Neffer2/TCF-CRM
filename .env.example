APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- BULLCRM: SMS (Hablame) ---
SMS_MODO=api            # api | log (log = no envía, solo registra; usar en local)
SMS_TOKEN=              # X-Hablame-Key
SMS_REMITENTE=BUllCRM
SMS_SALUDO_TELEFONO=

# --- BULLCRM: notificaciones y alertas a desarrollo ---
CRM_NOTIF_REINTENTOS=3
CRM_ALERTA_CORREOS=data@bullmarketing.com.co   # separados por coma
CRM_ALERTA_TELEFONOS=                          # separados por coma (SMS)
CRM_ALERTA_CADA_MINUTOS=60
# Para enviar correos/SMS fuera del request (cola) poner QUEUE_CONNECTION=database,
# crear la tabla con `php artisan queue:table && php artisan migrate` y correr `php artisan queue:work`.

# --- BULLCRM: negocio ---
CRM_ANTICIPO_UMBRAL_GERENCIA=500000   # anticipos de productor por debajo no pasan por gerencia
