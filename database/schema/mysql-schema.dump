DROP TABLE IF EXISTS `actividad_log`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `actividad_log` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `user_id` bigint unsigned DEFAULT NULL COMMENT 'Usuario que hizo la acción (users.id); NULL en intentos de acceso fallidos',
  `usuario` varchar(120) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Nombre en el momento (por si la cuenta cambia)',
  `rol` bigint unsigned DEFAULT NULL COMMENT 'Rol activo del usuario en ese momento (roles.id)',
  `tipo` varchar(12) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'sesion | pagina | accion | datos',
  `accion` varchar(160) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Qué hizo: ruta, componente.metodo, modelo:evento, login/logout',
  `objeto` varchar(120) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Registro afectado, p. ej. ordenes_compra:123',
  `detalle` json DEFAULT NULL COMMENT 'Datos enviados o cambios (antes -> después), sin claves',
  `metodo` varchar(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Método HTTP (GET, POST…)',
  `ruta` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Ruta visitada o acción ejecutada',
  `estado_http` smallint unsigned DEFAULT NULL COMMENT 'Código de respuesta HTTP (200, 403, 500…)',
  `duracion_ms` int unsigned DEFAULT NULL COMMENT 'Tiempo de respuesta en milisegundos',
  `ip` varchar(45) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Dirección IP del navegador',
  `navegador` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Identificación del navegador (User-Agent)',
  `created_at` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT 'Creación del registro',
  PRIMARY KEY (`id`),
  KEY `actividad_log_user_id_index` (`user_id`),
  KEY `actividad_log_tipo_index` (`tipo`),
  KEY `actividad_log_created_at_index` (`created_at`),
  KEY `actividad_log_rol_foreign` (`rol`),
  CONSTRAINT `actividad_log_rol_foreign` FOREIGN KEY (`rol`) REFERENCES `roles` (`id`) ON DELETE SET NULL,
  CONSTRAINT `actividad_log_user_id_foreign` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE SET NULL,
  CONSTRAINT `chk_actividad_log_tipo` CHECK ((`tipo` in (_utf8mb4'accion',_utf8mb4'datos',_utf8mb4'pagina',_utf8mb4'sesion')))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Auditoría: páginas, acciones, sesiones y cambios de datos por usuario';
/*!40101 SET character_set_client = @saved_cs_client */;
