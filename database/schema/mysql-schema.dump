DROP TABLE IF EXISTS `ordenes_compra`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `ordenes_compra` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `tipo_oc` bigint unsigned NOT NULL COMMENT '1 jurídica (proveedor), 2 natural (persona), 3 nómina -> tipo_ordenes_compra.id',
  `estado_id` bigint unsigned NOT NULL DEFAULT '2' COMMENT '-> estados_ordenes_compra.id',
  `fecha_aprobacion` datetime DEFAULT NULL COMMENT 'Fecha de aprobación',
  `fecha_envio_produccion` datetime DEFAULT NULL COMMENT 'Fecha en que el productor la envió a aprobación',
  `presupuesto_id` bigint unsigned DEFAULT NULL COMMENT 'Presupuesto que consume (NULL en órdenes naturales; ver natural_info) -> presupuesto_proyecto.id',
  `proveedor_id` bigint unsigned NOT NULL COMMENT '-> proveedores.id (3 = cuenta de cobro/persona natural)',
  `justificacion_rechazo` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Motivo del rechazo',
  `observaciones_negociacion` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observaciones del controller al aprobar',
  `archivo_cot` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Cotización del proveedor adjunta por el productor',
  `archivo_orden_helisa` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'PDF de la orden generado al aprobar (para Helisa)',
  `cod_causal` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Código de causación contable (flujo viejo)',
  `observacion_causal` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observación de contabilidad al causar',
  `archivo_comprobante_pago` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Comprobante de pago (flujo viejo de anticipos sobre la orden)',
  `archivo_remision` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'PDF de la remisión firmada',
  `archivo_cuenta_cobro` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'PDF de la cuenta de cobro (persona natural), ruta en storage',
  `observacion_remision` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observaciones al firmar la remisión',
  `archivo_firma` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Imagen de la firma del productor en la remisión',
  `cod_oc` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Código de la orden asignado al aprobar (OC{id})',
  `gr` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Código del Good Receive (GR{id}) cuando se comprueba',
  `actualizado` tinyint(1) NOT NULL DEFAULT '0' COMMENT 'Marca de orden actualizada tras aprobación',
  `observaciones_anulacion` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Motivo de anulación',
  `observaciones_revision_lider` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observación del líder de producción en su revisión (histórico; el historial completo está en historial_estados)',
  `rechazo_revision_lider` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Motivo de rechazo del líder de producción (histórico)',
  `observaciones_revision_gerencia` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observación de Gerencia en su revisión (histórico)',
  `rechazo_revision_gerencia` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Motivo de rechazo de Gerencia (histórico)',
  `observaciones_revision_evidencias` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observación en la revisión de evidencias (histórico)',
  `rechazo_revision_evidencias` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Motivo de rechazo de las evidencias (histórico)',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  `fecha_causal` datetime DEFAULT NULL COMMENT 'Cuándo se causó',
  `fecha_comprobante_pago` datetime DEFAULT NULL COMMENT 'Cuándo se registró el comprobante de pago',
  `observaciones` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'Observaciones generales de la orden',
  `deleted_at` timestamp NULL DEFAULT NULL COMMENT 'Borrado lógico: cuándo se envió a la papelera (NULL = vigente); se restaura desde Administración → Papelera',
  PRIMARY KEY (`id`),
  KEY `ordenes_compra_tipo_oc_foreign` (`tipo_oc`),
  KEY `ordenes_compra_estado_id_foreign` (`estado_id`),
  KEY `ordenes_compra_presupuesto_id_foreign` (`presupuesto_id`),
  KEY `ordenes_compra_proveedor_id_foreign` (`proveedor_id`),
  KEY `ordenes_compra_presto_estado_idx` (`presupuesto_id`,`estado_id`),
  KEY `ordenes_compra_cod_oc_index` (`cod_oc`),
  CONSTRAINT `ordenes_compra_estado_id_foreign` FOREIGN KEY (`estado_id`) REFERENCES `estados_ordenes_compra` (`id`),
  CONSTRAINT `ordenes_compra_presupuesto_id_foreign` FOREIGN KEY (`presupuesto_id`) REFERENCES `presupuesto_proyecto` (`id`),
  CONSTRAINT `ordenes_compra_proveedor_id_foreign` FOREIGN KEY (`proveedor_id`) REFERENCES `proveedores` (`id`),
  CONSTRAINT `ordenes_compra_tipo_oc_foreign` FOREIGN KEY (`tipo_oc`) REFERENCES `tipo_ordenes_compra` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Órdenes de compra: tipo_oc 1 jurídica, 2 natural (persona), 3 nómina. estado_id -> estados_ordenes_compra';
