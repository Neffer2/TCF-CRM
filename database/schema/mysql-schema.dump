DROP TABLE IF EXISTS `base_comerciales`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `base_comerciales` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `fecha` date NOT NULL COMMENT 'Fecha del registro (base de los dashboards por periodo)',
  `nom_cliente` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Nombre del cliente tal como se digitó',
  `nom_proyecto` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Nombre del proyecto',
  `cod_cc` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Centro de costos tal como se digitó (puede traer el nombre del proyecto); el código puro está en centro_costos',
  `centro_costos` varchar(12) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Código puro del centro de costos (el que usa Helisa), sin el nombre del proyecto; se llena solo al guardar cod_cc',
  `valor_original` decimal(15,2) DEFAULT '0.00' COMMENT 'Valor total del proyecto',
  `cotizacion_file_actualizacion` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Archivo de la cotización actualizada (ruta en storage)',
  `porcentaje` decimal(9,4) DEFAULT NULL COMMENT 'Participación del comercial en el proyecto (%)',
  `valor_proyecto` decimal(15,2) DEFAULT '0.00' COMMENT 'Valor atribuido al comercial (su porcentaje del proyecto)',
  `com_1` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Participación (%) del primer comercial (histórico; hoy en gestion_participantes)',
  `com_2` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Participación (%) del segundo comercial (histórico)',
  `com_3` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Participación (%) del tercer comercial (histórico)',
  `id_estado` bigint unsigned NOT NULL COMMENT 'Estado de la venta -> estados_cuenta.id',
  `fecha_inicio` date DEFAULT NULL COMMENT 'Inicio del proyecto',
  `dura_mes` date DEFAULT NULL COMMENT 'Duración en meses',
  `fecha_facturacion` date DEFAULT NULL COMMENT 'Fecha prevista de facturación',
  `id_user` bigint unsigned NOT NULL COMMENT 'Comercial al que se atribuye la venta -> users.id',
  `id_asistente` bigint unsigned DEFAULT NULL COMMENT 'Ejecutivo de cuenta que registró la venta (users.id)',
  `id_cuenta` bigint unsigned NOT NULL DEFAULT '1' COMMENT 'Cuenta/marca -> cuentas.id',
  `id_gestion` bigint unsigned DEFAULT NULL COMMENT '-> gestion_comercial.id',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  `deleted_at` timestamp NULL DEFAULT NULL COMMENT 'Borrado lógico: cuándo se envió a la papelera (NULL = vigente); se restaura desde Administración → Papelera',
  PRIMARY KEY (`id`),
  KEY `base_comerciales_id_estado_foreign` (`id_estado`),
  KEY `base_comerciales_id_user_foreign` (`id_user`),
  KEY `base_comerciales_id_asistente_foreign` (`id_asistente`),
  KEY `base_comerciales_id_cuenta_foreign` (`id_cuenta`),
  KEY `base_comerciales_id_gestion_foreign` (`id_gestion`),
  KEY `base_comerciales_user_fecha_idx` (`id_user`,`fecha`),
  KEY `base_comerciales_centro_costos_index` (`centro_costos`),
  CONSTRAINT `base_comerciales_id_asistente_foreign` FOREIGN KEY (`id_asistente`) REFERENCES `users` (`id`),
  CONSTRAINT `base_comerciales_id_cuenta_foreign` FOREIGN KEY (`id_cuenta`) REFERENCES `cuentas` (`id`),
  CONSTRAINT `base_comerciales_id_estado_foreign` FOREIGN KEY (`id_estado`) REFERENCES `estados_cuenta` (`id`),
  CONSTRAINT `base_comerciales_id_gestion_foreign` FOREIGN KEY (`id_gestion`) REFERENCES `gestion_comercial` (`id`),
  CONSTRAINT `base_comerciales_id_user_foreign` FOREIGN KEY (`id_user`) REFERENCES `users` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Base comercial: valor de venta de cada proyecto por comercial. Alimenta los dashboards de venta';
/*!40101 SET character_set_client = @saved_cs_client */;
