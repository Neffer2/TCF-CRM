  KEY `historial_item_presupuesto_foreign` (`item_presupuesto_id`),
  KEY `historial_user_foreign` (`user_id`),
  CONSTRAINT `historial_item_presupuesto_foreign` FOREIGN KEY (`item_presupuesto_id`) REFERENCES `items_presupuesto` (`id`) ON DELETE CASCADE,
  CONSTRAINT `historial_user_foreign` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE SET NULL,
  CONSTRAINT `historial_items_presupuesto_chk_1` CHECK (json_valid(`valores_anteriores`))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Snapshot JSON de un ítem antes de cada modificación (auditoría de cambios)';
