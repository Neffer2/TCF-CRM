DROP TABLE IF EXISTS `gestion_comercial`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `gestion_comercial` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `id_contacto` bigint unsigned NOT NULL COMMENT 'Contacto (persona) que origina el lead -> contactos.id',
  `tipo_contacto` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Canal por el que llegó el contacto',
  `desc_contacto` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Descripción del primer contacto',
  `presto_cot` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Valor cotizado (presupuesto de la cotización)',
  `participaciones` decimal(8,2) NOT NULL DEFAULT '1.00' COMMENT 'Número de comerciales que participan (1 a 4). El detalle está en gestion_participantes',
  `nom_proyecto_cot` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Nombre del proyecto en la cotización',
  `fecha_estimada_cot` date DEFAULT NULL COMMENT 'Fecha estimada de ejecución (cotización)',
  `cotizacion_file` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Archivo de la cotización',
  `claro` tinyint(1) DEFAULT NULL COMMENT '1 si el cliente es Claro (tenía reglas de aprobación propias)',
  `presto_prop` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Valor de la propuesta',
  `nom_proyecto_prop` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Nombre del proyecto en la propuesta',
  `fecha_estimada_prop` date DEFAULT NULL COMMENT 'Fecha estimada (propuesta)',
  `propuesta_url` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Enlace a la propuesta enviada al cliente',
  `causa` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Causa de pérdida/cierre cuando la decisión es negativa',
  `id_estado` bigint unsigned NOT NULL DEFAULT '1' COMMENT 'Etapa del embudo -> estados_gestion_comercial.id',
  `id_user` bigint unsigned NOT NULL COMMENT 'Comercial responsable (dueño) de la gestión -> users.id',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Apertura de la gestión',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Último movimiento',
  `deleted_at` timestamp NULL DEFAULT NULL COMMENT 'Borrado lógico: cuándo se envió a la papelera (NULL = vigente); se restaura desde Administración → Papelera',
  PRIMARY KEY (`id`),
  KEY `gestion_comercial_id_contacto_foreign` (`id_contacto`),
  KEY `gestion_comercial_id_estado_foreign` (`id_estado`),
  KEY `gestion_comercial_id_user_foreign` (`id_user`),
  KEY `gestion_comercial_user_estado_idx` (`id_user`,`id_estado`),
  CONSTRAINT `gestion_comercial_id_contacto_foreign` FOREIGN KEY (`id_contacto`) REFERENCES `contactos` (`id`),
  CONSTRAINT `gestion_comercial_id_estado_foreign` FOREIGN KEY (`id_estado`) REFERENCES `estados_gestion_comercial` (`id`),
  CONSTRAINT `gestion_comercial_id_user_foreign` FOREIGN KEY (`id_user`) REFERENCES `users` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Gestión comercial (lead/oportunidad/proyecto). Un registro por proyecto en el embudo; los participantes están en gestion_participantes';
/*!40101 SET character_set_client = @saved_cs_client */;
DROP TABLE IF EXISTS `gestion_participantes`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `gestion_participantes` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `gestion_id` bigint unsigned NOT NULL COMMENT '-> gestion_comercial.id',
  `user_id` bigint unsigned NOT NULL COMMENT 'Comercial participante -> users.id',
  `posicion` tinyint unsigned NOT NULL DEFAULT '1' COMMENT '1 = responsable de la gestión; 2..4 = participantes adicionales',
  `porcentaje` decimal(5,2) NOT NULL DEFAULT '0.00' COMMENT 'Porcentaje de la venta que se le atribuye (la suma debería ser 100)',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  PRIMARY KEY (`id`),
  UNIQUE KEY `gestion_usuario_unico` (`gestion_id`,`user_id`),
  KEY `gestion_participantes_user_id_foreign` (`user_id`),
  CONSTRAINT `gestion_participantes_gestion_id_foreign` FOREIGN KEY (`gestion_id`) REFERENCES `gestion_comercial` (`id`) ON DELETE CASCADE,
  CONSTRAINT `gestion_participantes_user_id_foreign` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Comerciales que participan en una gestión (posición 1 = responsable) con su porcentaje';
/*!40101 SET character_set_client = @saved_cs_client */;
DROP TABLE IF EXISTS `helisa`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `helisa` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `fecha` date NOT NULL COMMENT 'Fecha del movimiento contable',
  `tipo_doc` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Tipo de documento contable',
  `num_doc` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Número de documento/factura',
  `concepto` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Concepto del asiento',
  `identidad` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'NIT/cédula del tercero',
  `nom_tercero` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Nombre del tercero facturado',
  `centro` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Centro de costos',
  `nom_centro_costo` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Nombre del centro de costos',
  `debito` decimal(12,2) DEFAULT NULL COMMENT 'Valor débito',
  `credito` decimal(12,2) DEFAULT NULL COMMENT 'Valor crédito',
  `porcentaje` decimal(9,4) DEFAULT NULL COMMENT 'Participación del comercial en la factura (%)',
  `comercial` bigint unsigned NOT NULL COMMENT 'Comercial al que se atribuye -> users.id',
  `id_cuenta` bigint unsigned NOT NULL DEFAULT '1' COMMENT 'Cuenta/marca -> cuentas.id',
  `participacion` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Número de comerciales que participan en la factura',
  `base_factura` decimal(12,2) NOT NULL COMMENT 'Base de la factura: valor sobre el que se liquida la venta y la comisión',
  `mes` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Mes contable -> meses.id',
  `año` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Año contable',
  `comision` decimal(12,2) NOT NULL COMMENT 'Comisión calculada para el comercial (puede ser negativa en ajustes)',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  `deleted_at` timestamp NULL DEFAULT NULL COMMENT 'Borrado lógico: cuándo se envió a la papelera (NULL = vigente); se restaura desde Administración → Papelera',
  PRIMARY KEY (`id`),
  KEY `helisa_comercial_foreign` (`comercial`),
  KEY `helisa_id_cuenta_foreign` (`id_cuenta`),
  KEY `helisa_centro_num_doc_idx` (`centro`,`num_doc`),
  KEY `helisa_comercial_fecha_idx` (`comercial`,`fecha`),
  CONSTRAINT `helisa_comercial_foreign` FOREIGN KEY (`comercial`) REFERENCES `users` (`id`),
  CONSTRAINT `helisa_id_cuenta_foreign` FOREIGN KEY (`id_cuenta`) REFERENCES `cuentas` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Asientos de facturación exportados/registrados para el contable Helisa. Un documento puede tener varias filas (una por comercial y ajustes)';
/*!40101 SET character_set_client = @saved_cs_client */;
DROP TABLE IF EXISTS `historial_estados`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `historial_estados` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `tabla` varchar(40) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Tabla del registro: ordenes_compra, anticipos, presupuesto_proyecto, gestion_comercial o terceros',
  `registro_id` bigint unsigned NOT NULL COMMENT 'id del registro en esa tabla',
  `estado_anterior` bigint unsigned DEFAULT NULL COMMENT 'Estado antes del cambio (NULL al crear el registro o en la carga inicial)',
  `estado_nuevo` bigint unsigned NOT NULL COMMENT 'Estado después del cambio (id del catálogo de estados de esa tabla)',
  `user_id` bigint unsigned DEFAULT NULL COMMENT 'Quién hizo el cambio (users.id); NULL = proceso automático o carga inicial',
  `rol` bigint unsigned DEFAULT NULL COMMENT 'Rol activo de quien hizo el cambio (roles.id)',
  `observacion` text COLLATE utf8mb4_unicode_ci COMMENT 'Justificación u observación escrita en ese paso, si la hubo',
  `origen` varchar(160) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Ruta de la pantalla desde la que se hizo, "consola" o "carga inicial"',
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP COMMENT 'Momento del cambio',
  PRIMARY KEY (`id`),
  KEY `historial_estados_registro_idx` (`tabla`,`registro_id`),
  KEY `historial_estados_created_at_index` (`created_at`),
  KEY `historial_estados_user_id_foreign` (`user_id`),
  KEY `historial_estados_rol_foreign` (`rol`),
  CONSTRAINT `historial_estados_rol_foreign` FOREIGN KEY (`rol`) REFERENCES `roles` (`id`) ON DELETE SET NULL,
  CONSTRAINT `historial_estados_user_id_foreign` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Historial de cambios de estado (una fila por cambio) de órdenes, anticipos, presupuestos, gestiones y terceros; lo escribe HistorialEstadoObserver';
/*!40101 SET character_set_client = @saved_cs_client */;
