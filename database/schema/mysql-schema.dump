  `clave` varchar(120) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Nombre normalizado (sin tildes, puntos ni espacios dobles): une variantes como BOGOTA D.C, BOGOTÁ D.C. y BOGOTA DC',
  `orden` smallint unsigned NOT NULL DEFAULT '999' COMMENT 'Posición en los desplegables (la lista oficial primero)',
  `activa` tinyint(1) NOT NULL DEFAULT '1' COMMENT '1 = se ofrece en los desplegables; 0 = variante vieja de los datos, solo para enlazar filas antiguas',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'CreaciÃ³n del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Ãšltima modificaciÃ³n',
  PRIMARY KEY (`id`),
  UNIQUE KEY `ciudades_clave_unique` (`clave`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Catálogo de ciudades: reemplaza la lista fija del código y unifica el texto libre de ítems, proveedores, terceros y contactos';
