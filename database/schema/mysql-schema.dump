  `valores_anteriores` json NOT NULL COMMENT 'Copia del ítem antes del cambio (JSON); con tipo_registro = snapshot_aprobacion guarda todos los ítems al aprobar',
  `user_id` bigint unsigned DEFAULT NULL COMMENT 'Quién hizo el cambio (users.id)',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
