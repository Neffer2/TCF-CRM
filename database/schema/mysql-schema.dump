  KEY `presupuestos_id_user_foreign` (`id_user`),
  CONSTRAINT `presupuestos_ano_id_foreign` FOREIGN KEY (`ano_id`) REFERENCES `anos` (`id`),
  CONSTRAINT `presupuestos_id_user_foreign` FOREIGN KEY (`id_user`) REFERENCES `users` (`id`),
  CONSTRAINT `presupuestos_mes_id_foreign` FOREIGN KEY (`mes_id`) REFERENCES `meses` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Presupuesto (meta) comercial por año/mes/comercial';
