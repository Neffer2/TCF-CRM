DROP TABLE IF EXISTS `items_anticipo`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `items_anticipo` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `anticipo_id` bigint unsigned NOT NULL COMMENT '-> anticipos.id',
  `item_id` bigint unsigned NOT NULL COMMENT 'Ítem de presupuesto -> items_presupuesto.id',
  `display_item` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Número del ítem tal como se muestra en el presupuesto',
  `desc` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Descripción del ítem',
  `cant` int NOT NULL COMMENT 'Cantidad',
  `dias` int NOT NULL COMMENT 'Días',
  `otros` int NOT NULL COMMENT 'Otros (meses u otro multiplicador)',
  `vunit` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Valor unitario',
  `vtotal` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Valor total del ítem',
  `vanticipo` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Valor anticipado (<= vtotal)',
  `saldo` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'vtotal - vanticipo',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  PRIMARY KEY (`id`),
  KEY `items_anticipo_anticipo_id_foreign` (`anticipo_id`),
  KEY `items_anticipo_item_id_foreign` (`item_id`),
  CONSTRAINT `items_anticipo_anticipo_id_foreign` FOREIGN KEY (`anticipo_id`) REFERENCES `anticipos` (`id`),
  CONSTRAINT `items_anticipo_item_id_foreign` FOREIGN KEY (`item_id`) REFERENCES `items_presupuesto` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Ítems de presupuesto incluidos en un anticipo de productor, con valor anticipado y saldo';
/*!40101 SET character_set_client = @saved_cs_client */;
DROP TABLE IF EXISTS `items_presupuesto`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `items_presupuesto` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `presupuesto_id` bigint unsigned NOT NULL COMMENT '-> presupuesto_proyecto.id',
  `num_item` int DEFAULT NULL COMMENT 'Número de ítem visible al usuario (secuencial dentro del presupuesto)',
  `orden` int DEFAULT NULL COMMENT 'Orden de presentación',
  `cod` int NOT NULL COMMENT 'Código/categoría del ítem',
  `evento` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '0' COMMENT '1 = fila de evento (agrupador sin valores), 0 = ítem normal',
  `cantidad` int NOT NULL COMMENT 'Cantidad de unidades',
  `dia` int NOT NULL COMMENT 'Número de días',
  `otros` int NOT NULL COMMENT 'Otro multiplicador (p.ej. personas). Cantidad total = cantidad * dia * otros',
  `descripcion` varchar(2000) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Descripción del ítem o del evento',
  `v_unitario` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Costo unitario interno',
  `v_total` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Costo total interno (cantidad * dia * otros * v_unitario)',
  `v_total_cliente` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Valor total al cliente (variante usada en cotización)',
  `proveedor_legacy` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'OBSOLETO: valor original del proveedor. Usar item_presupuesto_proveedor',
  `margen_utilidad` double(15,10) NOT NULL DEFAULT '0.0000000000' COMMENT 'Factor costo ÷ precio del ítem (p. ej. 0,70): el precio al cliente es el costo ÷ este factor y el margen del ítem es 1 − factor (0,70 → 30 %)',
  `mes_id` bigint unsigned DEFAULT NULL COMMENT 'Periodo (meses.id) en que se ejecuta el ítem; NULL = sin mes (eventos)',
  `dias` int NOT NULL COMMENT 'Días de ejecución (dato informativo)',
  `ciudad` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Ciudad de ejecución',
  `ciudad_id` bigint unsigned DEFAULT NULL COMMENT 'Ciudad del catálogo (ciudades.id) que corresponde al texto de la columna ciudad',
  `v_unitario_cot` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Precio unitario al cliente',
  `v_total_cot` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Precio total al cliente (base del margen)',
  `rentabilidad` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Rentabilidad calculada del ítem',
  `actualizado` tinyint(1) NOT NULL DEFAULT '0' COMMENT 'Marca de actualización tras asignado el centro de costos (0..3, ver código)',
  `actualizado_con` tinyint NOT NULL DEFAULT '0' COMMENT 'Marca de actualización vista por contabilidad',
  `disponible` tinyint(1) NOT NULL DEFAULT '1' COMMENT '1 = el ítem puede consumirse en órdenes/anticipos',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  PRIMARY KEY (`id`),
  KEY `items_presupuesto_presto_disponible_idx` (`presupuesto_id`,`disponible`),
  KEY `items_presupuesto_mes_id_foreign` (`mes_id`),
  KEY `items_presupuesto_ciudad_id_foreign` (`ciudad_id`),
  CONSTRAINT `items_presupuesto_ciudad_id_foreign` FOREIGN KEY (`ciudad_id`) REFERENCES `ciudades` (`id`) ON DELETE SET NULL,
  CONSTRAINT `items_presupuesto_mes_id_foreign` FOREIGN KEY (`mes_id`) REFERENCES `meses` (`id`) ON DELETE SET NULL,
  CONSTRAINT `items_presupuesto_presupuesto_id_foreign` FOREIGN KEY (`presupuesto_id`) REFERENCES `presupuesto_proyecto` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Ítems (líneas) de un presupuesto de proyecto. Sus proveedores están en item_presupuesto_proveedor';
/*!40101 SET character_set_client = @saved_cs_client */;
