/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `notificaciones_log` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `canal` varchar(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'correo | sms',
  `evento` varchar(80) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Función que originó el aviso (p. ej. mailOrdenAprobada)',
  `referencia` varchar(120) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Objeto relacionado, p. ej. oc:123, anticipo:4',
  `destinatarios` json NOT NULL COMMENT 'Correos/teléfonos a los que iba dirigido',
  `copias` json DEFAULT NULL COMMENT 'Destinatarios en copia (JSON)',
  `asunto` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Asunto del correo o texto del SMS',
  `cuerpo` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'HTML del correo o texto del SMS',
  `adjuntos` json DEFAULT NULL COMMENT 'Rutas en storage de los adjuntos',
  `estado` varchar(12) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'pendiente' COMMENT 'pendiente | enviado | fallido',
  `intentos` tinyint unsigned NOT NULL DEFAULT '0' COMMENT 'Intentos de envío realizados',
  `error` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'Último error de envío',
  `enviado_at` timestamp NULL DEFAULT NULL COMMENT 'Cuándo se envió',
  `alertado_at` timestamp NULL DEFAULT NULL COMMENT 'Cuándo se avisó a desarrollo del fallo',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  PRIMARY KEY (`id`),
  KEY `notificaciones_log_estado_created_at_index` (`estado`,`created_at`),
  KEY `notificaciones_log_canal_created_at_index` (`canal`,`created_at`),
  CONSTRAINT `chk_notificaciones_log_estado` CHECK ((`estado` in (_utf8mb4'pendiente',_utf8mb4'enviado',_utf8mb4'fallido')))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Registro de correos y SMS enviados por el CRM, con resultado y reintentos';
