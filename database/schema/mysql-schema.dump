DROP TABLE IF EXISTS `anticipo_pasos`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `anticipo_pasos` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `anticipo_id` bigint unsigned NOT NULL COMMENT 'Anticipo (anticipos.id)',
  `accion` varchar(30) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Acción ejecutada: solicitar, aprobar, rechazar, causar, pagar, anular, retirar…',
  `estado_desde` bigint unsigned DEFAULT NULL COMMENT 'Estado antes de la acción (estados_anticipo.id)',
  `estado_hasta` bigint unsigned NOT NULL COMMENT 'Estado después de la acción (estados_anticipo.id)',
  `user_id` bigint unsigned DEFAULT NULL COMMENT 'Quién ejecutó la acción (users.id)',
  `rol` bigint unsigned DEFAULT NULL COMMENT 'Rol activo con el que la ejecutó (roles.id)',
  `observacion` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'Observación o justificación escrita en ese paso',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  PRIMARY KEY (`id`),
  KEY `anticipo_pasos_user_id_foreign` (`user_id`),
  KEY `anticipo_pasos_anticipo_id_created_at_index` (`anticipo_id`,`created_at`),
  KEY `anticipo_pasos_rol_foreign` (`rol`),
  CONSTRAINT `anticipo_pasos_anticipo_id_foreign` FOREIGN KEY (`anticipo_id`) REFERENCES `anticipos` (`id`) ON DELETE CASCADE,
  CONSTRAINT `anticipo_pasos_rol_foreign` FOREIGN KEY (`rol`) REFERENCES `roles` (`id`) ON DELETE SET NULL,
  CONSTRAINT `anticipo_pasos_user_id_foreign` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Recorrido del anticipo jurídico: cada acción (solicitar, revisar, aprobar, rechazar, causar, pagar, anular, retirar) con quién, cuándo y con qué observación';
/*!40101 SET character_set_client = @saved_cs_client */;
DROP TABLE IF EXISTS `anticipos`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `anticipos` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `tipo` varchar(12) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'productor' COMMENT 'juridico (a un proveedor, sobre una orden de compra) o productor (caja del productor, con evidencias)',
  `oc_id` bigint unsigned DEFAULT NULL COMMENT 'Orden de compra (anticipo JURÍDICO). NULL en anticipos de productor',
  `presupuesto_id` bigint unsigned DEFAULT NULL COMMENT 'Presupuesto/centro de costos (anticipo de PRODUCTOR). NULL en jurídicos',
  `proveedor_id` bigint unsigned DEFAULT NULL COMMENT 'Proveedor beneficiario (proveedores.id), en el anticipo jurídico',
  `porcentaje_anticipo` decimal(5,2) DEFAULT NULL COMMENT 'Porcentaje de la orden que se anticipa (jurídico)',
  `valor_base` decimal(15,2) DEFAULT NULL COMMENT 'Valor sobre el que se calcula el porcentaje: la orden de compra vinculada o el valor digitado (borrador)',
  `total_anticipo` decimal(15,2) NOT NULL COMMENT 'Valor total a anticipar',
  `cod_orden_anticipo` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Código de la orden de anticipo (OA-…), único',
  `archivo_orden_anticipo` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'PDF de la orden de anticipo (ruta en storage)',
  `fecha_orden_anticipo` datetime DEFAULT NULL COMMENT 'Fecha de emisión del PDF de la orden de anticipo',
  `fecha_solicitud` datetime DEFAULT NULL COMMENT 'Cuándo lo pidió el productor',
  `fecha_aprobacion` datetime DEFAULT NULL COMMENT 'Cuándo quedó aprobado',
  `justificacion_rechazo` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Motivo del último rechazo (el historial completo está en historial_estados)',
  `productor_id` bigint unsigned NOT NULL COMMENT 'Productor que solicita -> users.id',
  `firma_productor` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Imagen de la firma del productor',
  `cod_causal` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Código de causación asignado por contabilidad',
  `observacion_causal` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'Observación de Contabilidad al causar',
  `observaciones_contabilidad` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'Observaciones de Contabilidad al devolver el anticipo',
  `fecha_causal` datetime DEFAULT NULL COMMENT 'Cuándo se causó',
  `comprobante_pago` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Comprobante de pago registrado por tesorería (si existe, ya fue pagado)',
  `fecha_comprobante_pago` datetime DEFAULT NULL COMMENT 'Fecha del pago',
  `observaciones_revision_lider` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observaciones del líder al aprobar',
  `rechazo_revision_lider` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Motivo de rechazo del líder',
  `observaciones_revision_gerencia` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observaciones de gerencia al aprobar',
  `rechazo_revision_gerencia` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Motivo de rechazo de gerencia',
  `observaciones_revision_evidencias` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observaciones al revisar evidencias',
  `rechazo_revision_evidencias` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Motivo de rechazo de evidencias',
  `estado_id` bigint unsigned NOT NULL DEFAULT '2' COMMENT '-> estados_anticipo.id',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  PRIMARY KEY (`id`),
  UNIQUE KEY `anticipos_cod_orden_anticipo_unique` (`cod_orden_anticipo`),
  KEY `anticipos_oc_id_foreign` (`oc_id`),
  KEY `anticipos_productor_id_foreign` (`productor_id`),
  KEY `anticipos_estado_id_foreign` (`estado_id`),
  KEY `anticipos_presupuesto_id_foreign` (`presupuesto_id`),
  KEY `anticipos_proveedor_id_foreign` (`proveedor_id`),
  KEY `anticipos_tipo_index` (`tipo`),
  CONSTRAINT `anticipos_estado_id_fk_estados_anticipo` FOREIGN KEY (`estado_id`) REFERENCES `estados_anticipo` (`id`),
  CONSTRAINT `anticipos_oc_id_foreign` FOREIGN KEY (`oc_id`) REFERENCES `ordenes_compra` (`id`),
  CONSTRAINT `anticipos_presupuesto_id_foreign` FOREIGN KEY (`presupuesto_id`) REFERENCES `presupuesto_proyecto` (`id`) ON DELETE CASCADE,
  CONSTRAINT `anticipos_productor_id_foreign` FOREIGN KEY (`productor_id`) REFERENCES `users` (`id`),
  CONSTRAINT `anticipos_proveedor_id_foreign` FOREIGN KEY (`proveedor_id`) REFERENCES `proveedores` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT `chk_anticipos_tipo` CHECK ((`tipo` in (_utf8mb4'juridico',_utf8mb4'productor')))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Anticipos de dinero: jurídicos (oc_id) o de productor (presupuesto_id). estado_id -> estados_anticipo';
/*!40101 SET character_set_client = @saved_cs_client */;
