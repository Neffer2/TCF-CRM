  `desc_oc` varchar(2000) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Descripción en la orden',
  `cant_oc` int NOT NULL COMMENT 'Cantidad consumida',
  `dias_oc` int NOT NULL COMMENT 'Días',
  `otros_oc` int NOT NULL COMMENT 'Otro multiplicador',
  `vunit_oc` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Valor unitario',
  `vtotal_oc` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Valor total de la línea (descuenta del saldo del ítem)',
  `tipo_servicio` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Tipo de servicio (órdenes naturales)',
  `tipo_contrato` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Tipo de contrato (órdenes naturales)',
  `cantidad_horas` int DEFAULT NULL COMMENT 'Horas (órdenes de nómina)',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
