  CONSTRAINT `asistentes_comercial_id_foreign` FOREIGN KEY (`comercial_id`) REFERENCES `users` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Relación ejecutivo de cuenta (asistente_id) -> comercial al que apoya (comercial_id)';
