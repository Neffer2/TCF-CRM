DROP TABLE IF EXISTS `users`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `users` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `name` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Nombre completo',
  `email` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Correo (único): es el usuario de acceso',
  `telefono` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Celular (se usa para SMS de notificación)',
  `email_verified_at` timestamp NULL DEFAULT NULL COMMENT 'Cuándo verificó el correo (no se usa)',
  `password` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Contraseña cifrada',
  `rol` bigint unsigned NOT NULL DEFAULT '2' COMMENT 'Rol ACTIVO (FK lógica a roles_user). Los demás roles de la cuenta están en role_user',
  `avatar` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'public/photos/avatar.jpg' COMMENT 'Ruta de la foto de perfil en storage',
  `remember_token` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Token de "recordarme"',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  PRIMARY KEY (`id`),
  UNIQUE KEY `users_email_unique` (`email`),
  KEY `users_rol_foreign` (`rol`),
  CONSTRAINT `users_rol_foreign` FOREIGN KEY (`rol`) REFERENCES `roles` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Cuentas de la plataforma. rol = rol ACTIVO (los roles asignables están en role_user)';
/*!40101 SET character_set_client = @saved_cs_client */;
/*!50003 DROP FUNCTION IF EXISTS `CapitalizeWords` */;
/*!50003 SET @saved_cs_client      = @@character_set_client */ ;
/*!50003 SET @saved_cs_results     = @@character_set_results */ ;
/*!50003 SET @saved_col_connection = @@collation_connection */ ;
/*!50003 SET character_set_client  = utf8mb4 */ ;
/*!50003 SET character_set_results = utf8mb4 */ ;
/*!50003 SET collation_connection  = utf8mb4_unicode_ci */ ;
/*!50003 SET @saved_sql_mode       = @@sql_mode */ ;
/*!50003 SET sql_mode              = 'NO_ENGINE_SUBSTITUTION' */ ;
DELIMITER ;;
CREATE FUNCTION `CapitalizeWords`(texto VARCHAR(255)) RETURNS varchar(255) CHARSET utf8mb4 COLLATE utf8mb4_unicode_ci
    DETERMINISTIC
BEGIN
    DECLARE i INT DEFAULT 1;
    DECLARE longitud INT DEFAULT LENGTH(texto);
    DECLARE resultado VARCHAR(255) DEFAULT '';
    DECLARE char_actual CHAR(1);
    DECLARE char_prev CHAR(1) DEFAULT ' ';

    WHILE i <= longitud DO
        SET char_actual = SUBSTRING(texto, i, 1);
        IF char_prev = ' ' THEN
            SET resultado = CONCAT(resultado, UPPER(char_actual));
        ELSE
            SET resultado = CONCAT(resultado, LOWER(char_actual));
        END IF;
        SET char_prev = char_actual;
        SET i = i + 1;
    END WHILE;

    RETURN resultado;
END ;;
DELIMITER ;
/*!50003 SET sql_mode              = @saved_sql_mode */ ;
/*!50003 SET character_set_client  = @saved_cs_client */ ;
/*!50003 SET character_set_results = @saved_cs_results */ ;
/*!50003 SET collation_connection  = @saved_col_connection */ ;
/*!50003 DROP PROCEDURE IF EXISTS `sp_ordenes_compra_pendientes_anio` */;
/*!50003 SET @saved_cs_client      = @@character_set_client */ ;
/*!50003 SET @saved_cs_results     = @@character_set_results */ ;
/*!50003 SET @saved_col_connection = @@collation_connection */ ;
/*!50003 SET character_set_client  = utf8mb4 */ ;
/*!50003 SET character_set_results = utf8mb4 */ ;
/*!50003 SET collation_connection  = utf8mb4_unicode_ci */ ;
/*!50003 SET @saved_sql_mode       = @@sql_mode */ ;
/*!50003 SET sql_mode              = 'NO_ENGINE_SUBSTITUTION' */ ;
DELIMITER ;;
CREATE PROCEDURE `sp_ordenes_compra_pendientes_anio`(
    IN p_anio SMALLINT   -- puede ser NULL
)
BEGIN
    DECLARE v_anio SMALLINT;
    DECLARE v_start_date DATETIME;
    DECLARE v_end_date   DATETIME;

    -- Si no viene el año, se usa el año actual
    SET v_anio = IFNULL(p_anio, YEAR(CURDATE()));

    -- Primer día del año, 00:00:00
    SET v_start_date = STR_TO_DATE(CONCAT(v_anio, '-01-01 00:00:00'), '%Y-%m-%d %H:%i:%s');

    -- Si es el año actual, corta hasta "ahora" (como Carbon::now())
    -- si es un año distinto al actual, toma hasta el 31 de diciembre 23:59:59
    IF v_anio = YEAR(CURDATE()) THEN
        SET v_end_date = NOW();
    ELSE
        SET v_end_date = STR_TO_DATE(CONCAT(v_anio, '-12-31 23:59:59'), '%Y-%m-%d %H:%i:%s');
    END IF;

    SELECT *
    FROM ordenes_compra
    WHERE cod_causal IS NULL
      AND created_at BETWEEN v_start_date AND v_end_date
    ORDER BY created_at DESC;

END ;;
DELIMITER ;
/*!50003 SET sql_mode              = @saved_sql_mode */ ;
/*!50003 SET character_set_client  = @saved_cs_client */ ;
/*!50003 SET character_set_results = @saved_cs_results */ ;
/*!50003 SET collation_connection  = @saved_col_connection */ ;
