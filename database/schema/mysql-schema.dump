DROP TABLE IF EXISTS `tarifario`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `tarifario` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `concepto` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Concepto',
  `caso` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Caso o uso',
  `caracteristicas` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Características',
  `v_unidad` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Valor unitario de referencia',
  `observacion` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observación',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Tarifas de referencia para cotizar';
/*!40101 SET character_set_client = @saved_cs_client */;
DROP TABLE IF EXISTS `terceros`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `terceros` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `nombre` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Nombre',
  `apellido` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Apellido',
  `cedula` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Documento de identidad',
  `correo` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Correo',
  `telefono` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Teléfono',
  `servicio` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Servicio que presta',
  `ciudad` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Ciudad (texto); el enlace al catálogo está en ciudad_id',
  `ciudad_id` bigint unsigned DEFAULT NULL COMMENT 'Ciudad del catálogo (ciudades.id) que corresponde al texto de la columna ciudad',
  `banco` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Banco para el pago',
  `tipo_cuenta` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Tipo de cuenta bancaria',
  `num_cuenta` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Número de cuenta bancaria',
  `num_rut` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Número de RUT',
  `rut` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Archivo RUT',
  `cert_bancaria` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Certificación bancaria (archivo)',
  `copia_cedula` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Copia de la cédula (archivo)',
  `art383` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Formato artículo 383 (archivo)',
  `planilla_aportes` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Planilla de aportes (archivo)',
  `firma` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Imagen de la firma capturada en el portal',
  `estado` bigint unsigned NOT NULL DEFAULT '1' COMMENT '-> estados_tercero.id',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  `deleted_at` timestamp NULL DEFAULT NULL COMMENT 'Borrado lógico: cuándo se envió a la papelera (NULL = vigente); se restaura desde Administración → Papelera',
  PRIMARY KEY (`id`),
  KEY `terceros_estado_foreign` (`estado`),
  KEY `terceros_cedula_index` (`cedula`),
  KEY `terceros_ciudad_id_foreign` (`ciudad_id`),
  CONSTRAINT `terceros_ciudad_id_foreign` FOREIGN KEY (`ciudad_id`) REFERENCES `ciudades` (`id`) ON DELETE SET NULL,
  CONSTRAINT `terceros_estado_foreign` FOREIGN KEY (`estado`) REFERENCES `estados_tercero` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Personas naturales contratadas por producción (datos bancarios, RUT, firma)';
