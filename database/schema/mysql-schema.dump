DROP TABLE IF EXISTS `presupuesto_proyecto`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `presupuesto_proyecto` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'Identificador',
  `id_gestion` bigint unsigned NOT NULL COMMENT 'Gestión comercial a la que pertenece -> gestion_comercial.id',
  `estado_id` bigint unsigned NOT NULL DEFAULT '3' COMMENT '-> estados_presupuesto.id (1 = aprobado)',
  `margen_general` double(15,10) NOT NULL DEFAULT '0.0000000000' COMMENT 'Margen general (%) calculado a partir de los ítems',
  `venta_proy` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Valor de venta del proyecto (total al cliente)',
  `costos_proy` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Costos totales del proyecto (suma de los ítems)',
  `margen_proy` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Margen % del proyecto. Con menos del 30 % la aprobación es de Gerencia (AprobacionPresupuesto::MARGEN_GERENCIA)',
  `margen_bruto` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Margen bruto en pesos (venta − costos)',
  `cod_cot` int NOT NULL COMMENT 'Consecutivo de la cotización',
  `cod_cc` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Código de centro de costos asignado al aprobar',
  `centro_costos` varchar(12) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Código puro del centro de costos (el que usa Helisa), sin el nombre del proyecto; se llena solo al guardar cod_cc',
  `fecha_cc` date DEFAULT NULL COMMENT 'Fecha de asignación del centro de costos',
  `imprevistos` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Imprevistos (%) que se suman a la venta',
  `administracion` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Administración (%) que se suma a la venta',
  `fee` decimal(15,2) NOT NULL DEFAULT '0.00' COMMENT 'Fee (%) que se suma a la venta',
  `tiempo_factura` int NOT NULL DEFAULT '30' COMMENT 'Días para facturar',
  `notas` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Notas del presupuesto',
  `justificacion` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observaciones del comercial al enviar a aprobación',
  `justificacion_compras` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observaciones de compras/gerencia al aprobar o rechazar',
  `justificacion_lider` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Observaciones del líder comercial',
  `justificacion_gerencia` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Justificación de Gerencia al rechazar (histórico; ver historial_estados)',
  `productor` bigint unsigned DEFAULT NULL COMMENT 'Productor asignado a ejecutar el proyecto -> users.id',
  `notificacion_actualizacion` tinyint(1) DEFAULT NULL COMMENT 'Marca de notificación pendiente por actualización del presupuesto',
  `requiere_revalidacion` bigint DEFAULT '0' COMMENT '1 = hubo cambios después de aprobarse y debe volver a validarse',
  `created_at` timestamp NULL DEFAULT NULL COMMENT 'Creación del registro',
  `updated_at` timestamp NULL DEFAULT NULL COMMENT 'Última modificación',
  `deleted_at` timestamp NULL DEFAULT NULL COMMENT 'Borrado lógico: cuándo se envió a la papelera (NULL = vigente); se restaura desde Administración → Papelera',
  PRIMARY KEY (`id`),
  KEY `presupuesto_proyecto_id_gestion_foreign` (`id_gestion`),
  KEY `presupuesto_proyecto_estado_id_foreign` (`estado_id`),
  KEY `presupuesto_proyecto_productor_foreign` (`productor`),
  KEY `presupuesto_proyecto_centro_costos_index` (`centro_costos`),
  CONSTRAINT `presupuesto_proyecto_estado_id_foreign` FOREIGN KEY (`estado_id`) REFERENCES `estados_presupuesto` (`id`),
  CONSTRAINT `presupuesto_proyecto_id_gestion_foreign` FOREIGN KEY (`id_gestion`) REFERENCES `gestion_comercial` (`id`),
  CONSTRAINT `presupuesto_proyecto_productor_foreign` FOREIGN KEY (`productor`) REFERENCES `users` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Presupuesto de un proyecto (centro de costos): totales, margen, aprobación y productor asignado';
/*!40101 SET character_set_client = @saved_cs_client */;
